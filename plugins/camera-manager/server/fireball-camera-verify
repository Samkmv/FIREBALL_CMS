#!/usr/bin/perl

use strict;
use warnings;

my $begin_marker = '# FIREBALL CAMERA MANAGER: BEGIN';
my $end_marker = '# FIREBALL CAMERA MANAGER: END';
my $generated_comment = '# Generated by FIREBALL CMS. Edit cameras in Camera Manager, not here.';

@ARGV == 2 or die "Expected current and candidate streams.pl paths.\n";
my ($current_path, $candidate_path) = @ARGV;

sub read_file {
    my ($path) = @_;
    open my $handle, '<', $path or die "Unable to read streams.pl input.\n";
    local $/;
    my $contents = <$handle>;
    close $handle;
    return defined $contents ? $contents : '';
}

sub split_managed_block {
    my ($contents, $required) = @_;
    my @lines = split /(?<=\n)/, $contents, -1;
    my (@begins, @ends);

    for my $index (0 .. $#lines) {
        my $line = $lines[$index];
        $line =~ s/\r?\n\z//;
        push @begins, $index if $line =~ /^\s*\Q$begin_marker\E\s*$/;
        push @ends, $index if $line =~ /^\s*\Q$end_marker\E\s*$/;
    }

    if (!@begins && !@ends) {
        die "Managed block is missing from candidate streams.pl.\n" if $required;
        return ($contents, []);
    }
    @begins == 1 && @ends == 1 && $begins[0] < $ends[0]
        or die "Managed block markers are incomplete or duplicated.\n";

    my ($begin, $end) = ($begins[0], $ends[0]);
    my @outside;
    push @outside, @lines[0 .. $begin - 1] if $begin > 0;
    push @outside, @lines[$end + 1 .. $#lines] if $end < $#lines;
    my @block = @lines[$begin .. $end];
    return (join('', @outside), \@block);
}

my ($current_outside) = split_managed_block(read_file($current_path), 0);
my ($candidate_outside, $candidate_block) = split_managed_block(read_file($candidate_path), 1);

$current_outside eq $candidate_outside
    or die "Candidate changes data outside the managed Camera Manager block.\n";

my %stream_keys;
my $comment_count = 0;
for (my $index = 1; $index < $#$candidate_block; $index++) {
    my $line = $candidate_block->[$index];
    $line =~ s/\r?\n\z//;
    if ($line =~ /^\s*\Q$generated_comment\E\s*$/) {
        $comment_count++;
        next;
    }

    my ($key, $url_source) = $line =~ /^\s*'([A-Za-z0-9_-]{1,64})'\s*=>\s*'(rtsp:\/\/(?:\\.|[^'\\\r\n])*)',\s*$/;
    defined $key && defined $url_source
        or die "Managed block contains an unsupported line.\n";
    $url_source !~ /[\x00-\x20\x7f]/
        or die "RTSP URL contains control characters or whitespace.\n";
    !$stream_keys{$key}++
        or die "Managed block contains a duplicate stream key.\n";
}

$comment_count == 1
    or die "Managed block must contain exactly one generator comment.\n";

for my $key (keys %stream_keys) {
    $candidate_outside !~ /['"]\Q$key\E['"]\s*=>/
        or die "Managed stream key already exists outside the Camera Manager block.\n";
}

exit 0;
