      },
      {
        "tag": "vpn-dns-out",
        "protocol": "dns"
      }
    ],
    "routing": {
      "domainStrategy": "AsIs",
      "rules": [
        {
          "type": "field",
          "inboundTag": [
            "vpn-dns"
          ],
          "balancerTag": "vpn-auto"
        },
        {
          "type": "field",
          "inboundTag": [
            "vpn-socks"
          ],
          "network": "tcp,udp",
          "port": "53",
          "outboundTag": "vpn-dns-out"
        },
        {
          "type": "field",
          "inboundTag": [
            "vpn-socks"
          ],
          "network": "tcp,udp",
          "balancerTag": "vpn-auto"
        }
      ],
      "balancers": [
        {
          "tag": "vpn-auto",
          "selector": [
            "vpn-node-"
          ],
          "fallbackTag": "vpn-block",
          "strategy": {
            "type": "leastPing"
          }
        }
      ]
    },
    "dns": {
      "tag": "vpn-dns",
      "servers": [
        "https://1.1.1.1/dns-query"
      ]
    },
    "observatory": {
      "subjectSelector": [
        "vpn-node-"
      ],
      "probeUrl": "https://www.google.com/generate_204",
      "probeInterval": "30s",
      "enableConcurrency": true
    }
  }
