            "spiderX": "/"
          }
        }
      },
      {
        "tag": "vpn-node-2",
        "protocol": "vless",
        "settings": {
          "vnext": [
            {
              "address": "node2.example",
              "port": 445,
              "users": [
                {
                  "id": "00000000-0000-4000-8000-000000000002",
                  "encryption": "none",
                  "flow": "xtls-rprx-vision"
                }
              ]
            }
          ]
        },
        "streamSettings": {
          "network": "tcp",
          "security": "reality",
          "realitySettings": {
            "serverName": "cover2.example",
            "fingerprint": "chrome",
            "publicKey": "AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI",
            "shortId": "02",
            "spiderX": "/"
          }
        }
      },
      {
        "tag": "vpn-node-3",
        "protocol": "vless",
        "settings": {
          "vnext": [
            {
              "address": "node3.example",
              "port": 446,
              "users": [
                {
                  "id": "00000000-0000-4000-8000-000000000003",
                  "encryption": "none",
                  "flow": "xtls-rprx-vision"
                }
              ]
            }
          ]
